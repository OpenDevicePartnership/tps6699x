    /// Display Port Configuration
    register DpConfig {
        address: 0x51,
        reset: 0x010100001C0603,
        fields: fieldset _ {
            size-bytes: 10,
        
            /// Assert this bit to enable DisplayPort SVID.
            field EnableDpSvid 0,
            /// Assert this bit to enable DisplayPort Alternate mode.
            field EnableDpMode 1,
            /// Display port capabilities
            field DpPortCapability 9:8 -> _ as enum DpPortCapability {
                Reserved: 0,
                UfpD: 1,
                DfpD: 2,
                Reserved2: 3,
            },
            /// Signaling for transport of DisplayPort protocol.
            field DpTransportSignalling 13:10 -> _ as enum DpTransportSignalling {
                Usb: 0,
                Dp: 1,
                Reserved: catch-all _,
            },
            /// USB data path support.
            field UsbDataPath 15 -> _ as enum DpUsbDataPath {
                MayBeRequired: 0,
                NotRequired: 1,
            },
            /// DFP_D Pin Assignments Supported. Each bit corresponds to an allowed pin assignment. Multiple pin assignments may be allowed.
            field DfpdPinAssignment 23:16,
            /// UFP_D Pin Assignments Supported. Each bit corresponds to an allowed pin assignment. Multiple pin assignments may be allowed.
            field UfpdPinAssignment 31:24,
            /// Assert this bit if multi-function is preferred.
            field MultiFunctionPreferred 32,
            /// This field indicates the status of the connection.
            field DfpdUfpdConnectionStatus 36:35 -> _ as enum DfpdUfpdConnected {
                Neither: 0,
                DfpD: 1,
                UfpD: 2,
                Both: 3,
            },
            /// DP VDO Version
            field DpVdoVersion 38:37 -> _ as enum DpVdoVersion {
                DpV20: 0,
                DpV21: 1,
                Reserved: catch-all _,
            },
            /// Assert this bit to enable auto-entry.
            field DpModeAutoEntryAllowed 40,
            /// Port Capability
            field PortCapability 49:48 -> _ as enum PortCapability {
                Reserved: 0,
                DpSink: 1,
                DpSource: 2,
                BothDpSourceAndSink: 3,
            },
            /// Transport Signalling
            field TransportSignalling 53:50,
            /// Receptacle Indication.
            field ReceptacleIndication 54 -> _ as enum ReceptacleIndication {
                Plug: 0,
                Receptacle: 1,
            },
            /// USB2 signaling requirement on A6 - A7 or B6 - B7 (D+/D-) while in DP configuration.
            field Usb2SignallingNotUsed 55 -> _ as enum Usb2SignalingNotUsed {
                MayBeRequired: 0,
                NotNeededOnA6A7: 1,
            },
            /// DP Source DevicePinAssignments Supported
            field DpSourceDevicePinAssignmentsSupported 63:56,
            /// DP Sink DevicePinAssignments Supported
            field DpSinkDevicePinAssignmentsSupported 71:64,
            /// UHBR13
            field Uhbr13 74,
