device Registers {
    default-byte-order: LE,
    register-address-type: u8,
    word-boundaries: "_:-: :bB:A1:1A:1a:a1:AAa",
    default-access: RW,

    /// Controller operation mode
    register Mode {
        address: 0x03,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 4,
        
            /// Controller operation mode
            field Mode 31:0,
        },
    },
    /// Customer use
    register CustomerUse {
        address: 0x06,
        reset: 0x0,
        fields: fieldset _ {
            size-bytes: 8,
        
            /// Controller operation mode
            field CustomerUse 63:0,
        },
    },
    /// Command 1 register
    register Cmd1 {
        address: 0x08,
        reset: 0x0,
        fields: fieldset _ {
            size-bytes: 4,
        
            /// Command value
            field Command 31:0,
        },
    },
    /// Command data 1 register
    register Data1 {
        address: 0x09,
        fields: fieldset _ {
            size-bytes: 64,

            /// Command payload byte
            field Bytes[64 stride 8] 7:0,
        },
    },
    /// Boot FW version
    register Version {
        address: 0x0F,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 4,
        
            /// Boot FW version
            field Version 31:0,
        },
    },
    /// Asserted interrupts for I2C1
    register IntEventBus1 {
        address: 0x14,
        reset: 0x02000008,
        access: RO,
        fields: fieldset _ {
            size-bytes: 11,
        
            /// A PD hard reset has been performed
            field HardReset 1,
            /// A plug has been inserted or removed
            field PlugEvent 3,
            /// Power swap completed
            field PowerSwapCompleted 4,
            /// Data swap completed
            field DataSwapCompleted 5,
            /// Fast role swap completed
            field FastRoleSwapCompleted 6,
            /// Source capabilities updated
            field SourceCapUpdated 7,
            /// Asserts under an implicit contract or an explicit contract when PS_RDY has been received
            field SinkReady 8,
            /// Overcurrent
            field Overcurrent 9,
            /// Attention received
            field AttentionReceived 10,
            /// VDM received
            field VDMReceived 11,
            /// New contract as consumer
            field NewConsumerContract 12,
            /// New contract as provider
            field NewProviderContract 13,
            /// Source capabilities received
            field SourceCapsReceived 14,
            /// Sink capabilities received
            field SinkCapsReceived 15,
            /// Power swap requested
            field PowerSwapRequested 17,
            /// Data swap requested
            field DataSwapRequested 18,
            /// USB host present
            field UsbHostPresent 20,
            /// Set when USB host status transitions to anything other than present
            field UsbHostNotPresent 21,
            /// Power path status register changed
            field PowerPathSwitchChanged 23,
            /// Data status register changed
            field DataStatusUpdated 25,
            /// Status register changed
            field StatusUpdated 26,
            /// PD status register changed
            field PdStatusUpdated 27,
            /// Command 1 completed
            field Cmd1Completed 30,
            /// Command 2 completed
            field Cmd2Completed 31,
            /// Device lacks PD or has incompatible PD version
            field DeviceIncompatible 32,
            /// Source cannot supply requested voltage or current
            field CannotSource 33,
            /// Source can supply requested voltage or current later
            field CanSourceLater 34,
            /// Voltage or current exceeded
            field PowerEventError 35,
            /// Device did not response to get caps message
            field NoCapsResponse 36,
            /// Unexpected message received from partner
            field ProtocolError 38,
            /// Sink transition completed
            field SinkTransitionCompleted 42,
            /// Plug connected but not debounced
            field PlugEarlyNotification 43,
            /// Prochot asserted
            field ProchotNotification 44,
            /// Source cannot produce negociated voltage or current
            field SourceCannotProvide 46,
            /// Alternate mode entry failed
            field AmEntryFail 48,
            /// Alternate mode entered
            field AmEntered 49,
            /// Discover modes process completed
            field DiscoverModeCompleted 51,
            /// Exit mode process completed
            field ExitModeCompleted 52,
            /// Data reset process started
            field DataResetStarted 53,
            /// USB status updated
            field UsbStatusUpdated 54,
            /// Connection manager updated
            field ConnectionManagerUpdated 55,
            /// User VID alternate mode entered
            field UsvidModeEntered 56,
            /// User VID alternate mode entered
            field UsvidModeExited 57,
            /// User VID SVDM attention received
            field UsvidAttentionVdmReceived 58,
            /// User VID SVDM non-attention or unstructured VDM received
            field UsvidOtherVdmReceived 59,
            /// External DCDC event
            field ExternalDcDcEvent 61,
            /// DP SID status register changed
            field DpSidStatusUpdated 62,
            /// Intel VID status register changed
            field IntelVidStatusUpdated 63,
            /// PD3 status register changed
            field Pd3StatusUpdated 64,
            /// TX memory buffer empty
            field TxMemoryBufferEmpty 65,
            /// Buffer for mbrd command received and ready
            field MbrdBufferReady 66,
            /// SOC ack timeout
            field SocAckTimeout 70,
            /// Not supported PD message received
            field NotSupportedReceived 71,
            /// Error configuring the crossbar mux
            field CrossbarError 72,
            /// Mailbox updated
            field MailboxUpdated 73,
            /// I2C error communicating with external bus
            field BusError 74,
            /// External DCDC status changed
            field ExternalDcDcStatusChanged 75,
            /// Fast role swap signal received
            field FrsSignalReceived 76,
            /// Chunk response received
            field ChunkResponseReceived 77,
            /// Chunk request received
            field ChunkRequestReceived 78,
            /// Alert message received
            field AlertMessageReceived 79,
            /// Patch loaded to device
            field PatchLoaded 80,
            /// Ready for F211 image
            field ReadyF211 81,
            /// Boot error
            field BootError 84,
            /// Ready for data block
            field ReadyForDataBlock 85,
        },
    },
    /// Masked interrupts for I2C1
    register IntMaskBus1 {
        address: 0x16,
        reset: 0x0F000000CD30380A,
        fields: IntEventBus1,
    },
    /// Set Sx App Config - system power state for application configuration
    register SxAppConfig {
        address: 0x20,
        reset: 0x0,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Current system power state
            field SleepState 2:0 -> _ as enum SystemPowerState {
                S0: 0,
                S3: 1,
                S4: 2,
                S5: 3,
                S0ix: 4,
                Reserved: catch-all _,
            },
        },
    },
    /// Discovered SVIDs
    register DiscoveredSvids {
        address: 0x21,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 33,

            /// Number of SVIDs discovered on SOP
            field NumberSopSvids 3:0,
            /// Number of SVIDs discovered on SOP'
            field NumberSopPrimeSvids 7:4,
            /// First SVID supported by SOP port partner
            field SvidSop0 23:8,
            /// Second SVID supported by SOP port partner
            field SvidSop1 39:24,
            /// Third SVID supported by SOP port partner
            field SvidSop2 55:40,
            /// Fourth SVID supported by SOP port partner
            field SvidSop3 71:56,
            /// Fifth SVID supported by SOP port partner
            field SvidSop4 87:72,
            /// Sixth SVID supported by SOP port partner
            field SvidSop5 103:88,
            /// Seventh SVID supported by SOP port partner
            field SvidSop6 119:104,
            /// Eighth SVID supported by SOP port partner
            field SvidSop7 135:120,
            /// First SVID supported by SOP' cable plug
            field SvidSopPrime0 151:136,
            /// Second SVID supported by SOP' cable plug
            field SvidSopPrime1 167:152,
            /// Third SVID supported by SOP' cable plug
            field SvidSopPrime2 183:168,
            /// Fourth SVID supported by SOP' cable plug
            field SvidSopPrime3 199:184,
            /// Fifth SVID supported by SOP' cable plug
            field SvidSopPrime4 215:200,
            /// Sixth SVID supported by SOP' cable plug
            field SvidSopPrime5 231:216,
            /// Seventh SVID supported by SOP' cable plug
            field SvidSopPrime6 247:232,
            /// Eighth SVID supported by SOP' cable plug
            field SvidSopPrime7 263:248,
        },
    },
    /// Interrupt clear for I2C1
    register IntClearBus1 {
        address: 0x18,
        reset: 0x0,
        fields: IntEventBus1,
    },
    /// Port status
    register Status {
        address: 0x1A,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 5,
        
            /// Plug present
            field PlugPresent 0,
            /// Connection state
            field ConnectionState 3:1 -> _ as enum PlugMode {
                NotConnected: 0,
                Disabled: 1,
                Audio: 2,
                DebugRdRd: 3,
                RaDetected: 4,
                DebugRpRp: 5,
                ConnectedNoRa: 6,
                Connected: 7,
            },
            /// Connector oreintation, 0 for normal, 1 for flipped
            field PlugOrientation 4,
            /// PD role, 0 for sink, 1 for source
            field PortRole 5,
            /// Data role, 0 for UFP, 1 for DFP
            field DataRole 6,
            /// Is EPR mode active
            field ErpMode 7,
            /// Vbus status
            field VbusStatus 21:20 -> _ as enum VbusMode {
                AtVsafe0: 0,
                Atvsafe5: 1,
                Normal: 2,
                Other: 3,
            },
            /// USB host mode
            field UsbHost 23:22 -> _ as enum UsbHostMode {
                NoHost: 0,
                AttachedNoData: 1,
                AttachedNoPd: 2,
                HostPresent: 3,
            },
            /// Legacy mode stotus
            field Legacy 25:24 -> _ as enum LegacyMode {
                NoLegacy: 0,
                LegacySink: 1,
                LegacySource: 2,
                LegacySinkDeadBattery: 3,
            },
            /// If a BIST is in progress
            field BistInProgress 27,
            /// Set when the SOC acknolwedgement has timed out
            field SocAckTimeout 30,
            /// Alternate mode entry status
            field AmStatus 33:32 -> _ as enum AmStatus {
                NoneAttempted: 0,
                EntrySuccessful: 1,
                EntryFailed: 2,
                PartialSuccess: 3,
            },
        },
    },
    /// Power path status
    register UsbStatus {
        address: 0x24,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 9,
        
            /// Enter USB4 mode status
            field EudoSopSentStatus 1:0 -> _ as enum EudoSopSentStatus {
                NoEnterUsb: 0,
                EnterUsbTimeout: 1,
                EnterUsbFailure: 2,
                SuccessfulEnterUsb: 3,
            },
            /// USB4 plug mode requirement
            field Usb4RequiredPlugMode 3:2 -> _ as enum Usb4RequiredPlugMode {
                None: 0,
                Reserved: 1,
                USB4: 2,
                TBT3: 3,
            },
            /// USB4 mode active on plug
            field UsbModeActiveOnPlug 4,
            /// vPro mode error. This bit is asserted ifa n error occurred while trying to enter the vPro mode.
            field VproEntryFailed 5,
            /// USB re-entry is needed
            field UsbReentryNeeded 6,
            /// Enter_USB Data Object (EUDO)
            field EnterUsbDataObject 39:8,
            /// vPro mode VDO.
            field TbtEnterModeVdo 71:40,
        },
    },
    /// Power path status
    register PowerPathStatus {
        address: 0x26,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 5,
        
            /// PA Vconn switch status
            field PaVconnSw 1:0 -> _ as enum PpVconnSw {
                Disabled: 0,
                DisabledFault: 1,
                Cc1: 2,
                Cc2: 3,
            },
            /// PA Vconn switch status
            field PbVconnSw 3:2 -> _ as PpVconnSw,
            /// PA int vbus switch status
            field PaIntVbusSw 8:6 -> _ as enum PpIntVbusSw {
                Disabled: 0,
                DisabledFault: 1,
                EnabledOutput: 2,
                Unknown: catch-all _,
            },
            /// PB int vbus switch status
            field PbIntVbusSw 11:9 -> _ as PpIntVbusSw,
            /// PA ext vbus switch status
            field PaExtVbusSw 14:12 -> _ as enum PpExtVbusSw {
                Disabled: 0,
                DisabledFault: 1,
                EnabledInput: 3,
                Unknown: catch-all _,
            },
            /// PB ext vbus switch status
            field PbExtVbusSw 17:15 -> _ as PpExtVbusSw,
            /// PA int vbus overcurrent
            field PaIntVbusOc 28,
            /// PB int vbus overcurrent
            field PbIntVbusOc 29,
            /// PA vconn overcurrent
            field PaVconnOc 34,
            /// PB vconn overcurrent
            field PbVconnOc 35,
            /// How the PD controller is powered
            field PowerSource 39:38 -> _ as enum PpPowerSource {
                Vin: 1,
                Vbus: 2,
                Unknown: catch-all _,
            },
        },
    },
    /// Global system configuration
    register SystemConfig {
        address: 0x27,
        reset: 0x10198C338905,
        fields: fieldset _ {
            size-bytes: 15,
        
            /// Enable PA VCONN
            field PaVconnConfig 0,
            /// Enable PB VCONN
            field PbVconnConfig 2,
            /// PA PP5V VBUS configuration
            field PaPp5vVbusSwConfig 10:8 -> _ as enum VbusSwConfig {
                Disabled: 0,
                Source: 1,
                Reserved: catch-all _,
            },
            /// PB PP5V VBUS configuration
            field PbPp5vVbusSwConfig 13:11 -> _ as VbusSwConfig,
            /// PP_5V ILIM configuration
            field IlimOverShoot 15:14 -> _ as enum IlimOverShoot {
                NoOvershoot: 0,
                Overshoot100ma: 1,
                Overshoot200ma: 2,
                Reserved: catch-all _,
            },
            /// PA PPEXT configuration
            field PaPpextVbusSwConfig 18:16 -> _ as enum PpextVbusSwConfig {
                Unused: 0,
                Source: 1,
                Sink: 2,
                SinkWaitSrdyNonDeadBattery: 3,
                BiDirectional: 4,
                BiDirectionalWaitSrdy: 5,
                SinkWaitSrdy: 6,
                BiDirectionalPpextDisabled: 7,
            },
            /// PB PPEXT configuration
            field PbPpextVbusSwConfig 21:19 -> _ as PpextVbusSwConfig,
            /// Threshold used for RCP on PP_EXT
            field RcpThreshold 23:22 -> _ as enum RcpThreshold {
                Threshold6mv: 0,
                Threshold8mv: 1,
                Threshold10mv: 2,
                Threshold12mv: 3,
            },
            /// Automatic sink-path coordination, true for highest power, false for no sink management
            field MultiPortSinkPolicyHighestPower 24,
            /// Type of TBT controller
            field TbtControllerType 28:26 -> _ as enum TbtControllerType {
                Default: 0,
                Ar: 1,
                Tr: 2,
                Icl: 3,
                Gr: 4,
                Br: 5,
                Reserved: catch-all _,
            },
            /// Enable bit for simple UFP policy manager
            field EnableOneUfpPolicy 29,
            /// Enable bit for simple source power management
            field EnableSpm 30,
            /// Delay configuration for MultiPortSinkPolicy
            field MultiPortSinkNonOverlapTime 32:31 -> _ as enum MultiPortSinkNonOverlapTime {
                Delay1ms: 0,
                Delay5ms: 1,
                Delay10ms: 2,
                Delay15ms: 3,
            },
            /// Enables I2C Multi Controller mode
            field EnableI2cMultiControllerMode 33,
            /// I2C bus timeout
            field I2cTimeout 36:34 -> _ as enum I2cTimeout {
                Timeout25ms: 0,
                Timeout50ms: 1,
                Timeout75ms: 2,
                Timeout100ms: 3,
                Timeout125ms: 4,
                Timeout150ms: 5,
                Timeout175ms: 6,
                Timeout1000ms: 7,
            },
            /// EEPROM updates not allowed if this bit asserted
            field DisableEepromUpdates 37,
            /// Enable only port A
            field EmulateSinglePort 38,
            /// SPM minimum current advertisement, true for 1.5 A, false for USB default
            field MinimumCurrentAdvertisement1A5 39,
            /// Value for USB default current
            field UsbDefaultCurrent 44:43 -> _ as enum UsbDefaultCurrent {
                UsbDefault: 0,
                Current900ma: 1,
                Current150ma: 2,
                Reserved: catch-all _,
            },
            /// EPR supported as source
            field EprSupportedAsSource 45,
            /// EPR supported as sink
            field EprSupportedAsSink 46,
            /// Enable AM entry/exit on low-power mode exit/entry
            field EnableLowPowerModeAmEntryExit 47,
            /// Enable crossbar polling mode
            field CrossbarPollingMode 54,
            /// Enable crossbar type 1 extended write
            field CrossbarConfigType1Extended 55,
            /// External DCDC Status Polling Interval
            field ExternalDcdcStatusPollingInterval 63:56,
            /// Target address for Port 1 on I2C2s
            field Port1I2c2TargetAddress 71:64,
            /// Target address for Port 2 on I2C2s
            field Port2I2c2TargetAddress 79:72,
            /// Halts setting up external DCDC configuration until 5V power is present from the system
            field VsysPreventsHighPower 80,
            /// Stalls the PD in PTCH mode until Vsys is present
            field WaitForVin3v3 81,
            /// Stalls the PD in PTCH mode until a power connection is made that meets the needed conditions
            field WaitForMinimumPower 82,
            /// On detecting VIN_3V3, auto clear the dead battery flag and reset the connection on the source port to update PD contract negotiated when the battery was dead
            field AutoClrDeadBatteryFlagAndResetOnVin3v3 86,
            /// Source Policy Mode
            field SourcePolicyMode 104:103,
        },
    },
    /// Port configuration
    register PortConfig {
        address: 0x28,
        reset: 0x0,
        fields: fieldset _ {
            size-bytes: 18,

            /// Type-C State machine
            field TypecStateMachine 1:0 -> _ as enum TypeCStateMachine {
                Sink: 0,
                Source: 1,
                Drp: 2,
                Disabled: 3,
            },
            /// Crossbar Type
            field CrossbarType 2:2 -> _ as enum CrossbarType {
                Type1: 0,
                Type2: 1,
            },
            /// PP_EXT ActiveLow
            field PpExtActiveLow 7,
            /// TypeC Support Options
            field TypecSupportOptions 9:8 -> _ as enum TypeCSupportOptions {
                None: 0,
                TrySrcDrp: 1,
                Reserved: catch-all _,
            },
            /// Disable PD
            field DisablePd 10,
            /// USB Communication Capable
            field UsbCommunicationCapable 11,
            /// DebugAccessory Support
            field DebugAccessorySupport 12,
            /// USB3 Rate
            field Usb3Rate 14:13 -> _ as enum Usb3Rate {
                NotSupported: 0,
                Gen1: 1,
                Gen2: 2,
                Reserved: catch-all _,
            },
            /// Crossbar I2C Controller enable
            field CrossbarI2cControllerEnable 15,
            /// VBUS OVP Usage
            field VbusOvpUsage 17:16 -> _ as enum VbusOvpUsage {
                Pct100: 0,
                Pct105: 1,
                Pct111: 2,
                Pct114: 3,
            },
            /// OVP for PP5V
            field OvpForPp5v 21:20 -> _ as enum OvpForPp5v {
                V5p25: 0,
                V5p5: 1,
                V5p8: 2,
                V6p1: 3,
            },
            /// Crossbar Config Type 1 Extended
            field CrossbarConfigType1Extended 22,
            /// Remove Safe-State Between USB3-to-DP Transition
            field RemoveSafeStateBetweenUsb3ToDpTransition 23,
            /// VBUS Sink UVP Trip HV
            field VbusSinkUvpTripHv 26:24 -> _ as enum VbusSinkUvpTripHv {
                Pct5: 0,
                Pct10: 1,
                Pct15: 2,
                Pct20: 3,
                Pct25: 4,
                Pct30: 5,
                Pct40: 6,
                Reserved: catch-all _,
            },
            /// APDO VBUS UVP Threshold
            field ApdoVbusUvpThreshold 28:27,
            /// APDO ILIM Over Shoot
            field ApdoIlimOverShoot 30:29,
            /// APDO VBUS Uvp TripPoint Offset
            field ApdoVbusUvpTripPointOffset 47:32,
            /// VBUS For Valid PPS Status
            field VbusForValidPpsStatus 63:48,
            /// External DCDC Type
            field ExternalDcdcType 71:64 -> _ as enum ExternalDcdcType {
                MarinaBay: 0,
                Bq25758: 1,
                Reserved: catch-all _,
            },
            /// Enables support for GPIO10 to I2C IRQ
            field SinkModeI2cIrqConfig 72,
            /// Threshold voltage to trigger the GREATER_THAN_THRESHOLD_VOLTAGE GPIO Event (50mV per LSB)
            field GtThresholdVoltage 95:80,
            /// Enable Internal Auxbiasing
            field EnableInternalAuxbiasing 124,
            /// EnableInternalLevelShifter
            field EnableInternalLevelShifter 125,
            /// Level shifter direction configuration
            field LevelShifterDirectionCfg 127:126 -> _ as enum LevelShifterDirectionCfg {
                Automatic: 0,
                GpioControlled: 1,
                I2cControlled: 2,
                Reserved: catch-all _,
            },
            /// SBU Mux Debug Setting
            field SbuMuxDebugSetting 130:128 -> _ as enum SbuMuxDebugSetting {
                DebugSnk: 0,
                UnorientedDebugSrc: 1,
                OrientedDebugSrc: 2,
                AnyDebug: 3,
                NeverEnable: 4,
                Reserved: catch-all _,
            },
            /// SBU Mux Default Setting
            field SbuMuxDefaultSetting 133:131 -> _ as enum SbuMuxDefaultSetting {
                DontChange: 0,
                DisableSbuMux: 1,
                EnableDbg: 2,
                Reserved: catch-all _,
            },
            /// Sbu Mux Usage
            field SbuMuxUsage 135:134 -> _ as enum SbuMuxUsage {
                DisplayPortAux: 0,
                AllAux: 1,
                Reserved: catch-all _,
            },
            /// EPR Supported as Source
            field EprSupportedAsSource 136,
            /// EPR Supported as Sink
            field EprSupportedAsSink 137,
            /// Disable sourcing in dead battery mode
            field DisableSourcingInDbm 138,
            /// Flip Px_DBG
            field FlipCrossbarDbgSetting 139,
            /// Flip Px_AUX
            field FlipCrossbarAuxSetting 140,
            /// Flip PX_SBTX/RX
            field FlipCrossbarSbtxSetting 141,
        },
    },
    /// Port control
    register PortControl {
        address: 0x29,
        reset: 0x06000041C311,
        fields: fieldset _ {
            size-bytes: 8,
        
            /// Type-C current limit
            field TypecCurrent 1:0 -> _ as enum TypecCurrent {
                UsbDefault: 0,
                Current1A5: 1,
                Current3A0: 2,
                Reserved: catch-all _,
            },
            /// Process swap to sink
            field ProcessSwapToSink 4,
            /// Initiate swap to sink
            field InitiateSwapToSink 5,
            /// Process swap to source
            field ProcessSwapToSource 6,
            /// Initiate swap to source
            field InitiateSwapToSource 7,
            /// Automatically initiate alert messaging
            field AutoAlertEnable 8,
            /// Automatically return PPS_Status
            field AutoPpsStatusEnable 10,
            /// Enable retimer firmware update
            field RetimerFwUpdate 11,
            /// Process swap to UFP
            field ProcessSwapToUfp 12,
            /// Initiate swap to UFP
            field InitiateSwapToUfp 13,
            /// Process swap to DFP
            field ProcessSwapToDfp 14,
            /// Initiate swap to DFP
            field InitiateSwapToDfp 15,
            /// Automatically issue discover identity VDMs to appropriate SOPs
            field AutomaticIdRequest 16,
            /// Allow host to manage alt mode process
            field AmIntrusiveMode 17,
            /// Force USB3 Gen1 mode
            field ForceUsb3Gen1 18,
            /// External power present
            field UnconstrainedPower 19,
            /// Enable current monitor using onboard ADC
            field EnableCurrentMonitor 20,
            /// Disable PP3/4 switches automatically
            field SinkControl 21,
            /// Enable fast role swap
            field FrSwapEnabled 22,
            /// Disable USB data
            field UsbDisable 29,
            /// Vconn current limit
            field VconnCurrentLimit 44:43 -> _ as enum VconnCurrentLimit {
                Current410ma: 0,
                Current590ma: 1,
                Other: catch-all _,
            },
            /// SBU Channel Control
            field ActiveDbgChannel 46:45 -> _ as enum ActiveDbgChannel {
                Dbg: 0,
                SbRxTx: 1,
                Aux: 2,
                Open: 3,
            },
        },
    },
    /// Boot flags
    register BootFlags {
        address: 0x2D,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 44,

            /// Current boot stage
            field BootStage 3:0,
            /// Number of ports
            field TotalNumPps 65:64,
            /// 1 if external power path is present
            field IsExtPpPresent 66,
            /// Dead battery flag
            field DeadBatteryFlag 128,
            /// Dead battery, port B is power provider
            field DbPortBPowerProvider 129,
            /// Dead battery, port A is power provider
            field DbPortAPowerProvider 130,
            /// Port A sink switch is enabled
            field PortASinkSwitch 131,
            /// Port B sink switch is enabled
            field PortBSinkSwitch 132,
            /// Port A I2C1 Target Address
            field PortA_I2c1TrgtAddr 167:160,
            /// Port B I2C1 Target Address
            field PortB_I2c1TrgtAddr 175:168,
            /// Port A I2C2 Target Address
            field PortA_I2c2TrgtAddr 183:176,
            /// Port B I2C2 Target Address
            field PortB_I2c2TrgtAddr 191:184,
            /// Port A I2C4 Target Address
            field PortA_I2c4TrgtAddr 199:192,
            /// Port B I2C4 Target Address
            field PortB_I2c4TrgtAddr 207:200,
            /// Active Bank the device booted from
            field ActiveBank 225:224,
            /// Asserted 1 if Bank 0 has valid Application Code
            field Bank0Valid 226,
            /// Asserted 1 if Bank 1 has valid Application Code
            field Bank1Valid 227,
            /// Application Firmware Version in Bank 0
            field Bank0FwVersion 287:256,
            /// Application Firmware Version in Bank 1
            field Bank1FwVersion 319:288,
            /// Raw ADCIN Value
            field AdcInValue 335:320,
            /// ADCIN Index
            field AdcInIndex 351:336,
        },
    },
    /// Received source capabilities
    register RxSrcCaps {
        address: 0x30,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 45,

            /// Number of valid standard PDOs
            field NumValidPdos 2:0,
            /// Number of valid EPR PDOs
            field NumValidEprPdos 5:3,
            /// Last source capabilities received is EPR
            field LastSrcCapIsEpr 6,
            /// Standard PDO 0
            field Pdo0 39:8,
            /// Standard PDO 1
            field Pdo1 71:40,
            /// Standard PDO 2
            field Pdo2 103:72,
            /// Standard PDO 3
            field Pdo3 135:104,
            /// Standard PDO 4
            field Pdo4 167:136,
            /// Standard PDO 5
            field Pdo5 199:168,
            /// Standard PDO 6
            field Pdo6 231:200,
            /// EPR PDO 0
            field EprPdo0 263:232,
            /// EPR PDO 1
            field EprPdo1 295:264,
            /// EPR PDO 2
            field EprPdo2 327:296,
            /// EPR PDO 3
            field EprPdo3 359:328,
        },
    },
    /// Received sink capabilities
    register RxSnkCaps {
        address: 0x31,
        reset: 0x0,
        access: RO,
        fields: RxSrcCaps,
    },
    /// Active PDO contract
    register ActivePdoContract {
        address: 0x34,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 6,
        
            /// Active PDO
            field ActivePdo 31:0,
            /// Bits 20-29 of the first PDO
            field FirstPdoControl 41:32,
        },
    },
    /// Active PDO contract
    register ActiveRdoContract {
        address: 0x35,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 16,
        
            /// Active RDO
            field ActiveRdo 31:0,
            /// Source EPR mode data object
            field SourceEprModeDo 63:32,
            /// Sink EPR mode data object
            field SinkEprModeDo 95:64,
            /// Accepted active RDO contract
            field AcceptedActiveRdo 127:96,
        },
    },
    /// Autonegotiate Sink
    register AutonegotiateSink {
        address: 0x37,
        reset: [0xBE, 0x40, 0x1F, 0x0F, 0x90, 0x91, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        fields: fieldset _ {
            size-bytes: 24,

            /// Configuration for tie-breaker in PDO selection
            field AutoNegRdoPriority 0:0 -> _ as enum AutoNegRdoPriority {
                HigherVoltage: 0,
                LowerVoltage: 1,
            },
            /// Value used for the NoUSBSusp Flag in the RDO
            field NoUsbSuspend 1,
            /// How to compute the minimum power that the sink requires
            field AutoComputeSinkMinPower 2:2 -> _ as enum AutoComputeSinkMinPower {
                ProvidedByHost: 0,
                ComputedByPdController: 1,
            },
            /// Configuration for capability mismatch in RDO
            field NoCapabilityMismatch 3:3 -> _ as enum NoCapabilityMismatch {
                Enabled: 0,
                Disabled: 1,
            },
            /// How to compute the minimum voltage that the sink requires
            field AutoComputeSinkMinVoltage 4:4 -> _ as enum AutoComputeSinkMinVoltage {
                ProvidedByHost: 0,
                ComputedByPdController: 1,
            },
            /// How to compute the maximum voltage that the sink requires
            field AutoComputeSinkMaxVoltage 5:5 -> _ as enum AutoComputeSinkMaxVoltage {
                ProvidedByHost: 0,
                ComputedByPdController: 1,
            },
            /// Sink path and capability mismatch setting
            field AutoDisableSinkUponCapabilityMismatch 6,
            /// Disable the sinking path during contract negotiation, and enable it back after receiving PS-RDY from SRC
            field AutoDisableInputForSinkStandby 7,
            /// Disable the sinking path during contract negotiation, and enable it back after receiving PS-RDY from SRC when in DBM
            field AutoDisableInputForSinkStandbyInDbm 8,
            /// Automatically re-enable the sink path for Sink Standby when PS-RDY is received
            field AutoEnableStandbySrdy 9,
            /// Keep the sink path disabled until final PD contract is set
            field AutoEnableInputAfterSnkReadyInDbm 10,
            /// Maximum current to request (10 mA per LSB)
            field AutoNegMaxCurrent 21:12,
            /// Minimum operating power required by the sink (250 mW per LSB)
            field AutoNegSinkMinRequiredPower 31:22,
            /// Maximum voltage to request (50 mV per LSB)
            field AutoNegMaxVoltage 41:32,
            /// Minimum voltage to request (50 mV per LSB)
            field AutoNegMinVoltage 51:42,
            /// Capabilities mismatch power threshold (250 mW per LSB)
            field AutoNegCapabilitiesMismatchPower 61:52,
            /// Enable Sink PPS mode
            field PpsEnableSinkMode 64,
            /// Sink PPS request interval
            field PpsRequestInterval 66:65 -> _ as enum PpsRequestInterval {
                EightSeconds: 0,
                FourSeconds: 1,
                TwoSeconds: 2,
                OneSecond: 3,
            },
            /// Selection for CV or CC mode
            field PpsSourceOperatingMode 67,
            /// Select only a source with full voltage range
            field PpsRequiredFullVoltageRange 68,
            /// Sink path handling during supply type transition
            field PpsDisableSinkUponNonApdoContract 69,
            /// Enable Sink Path above PPS Sink Voltage threshold
            field EnableSinkPathAbovePpsSinkVoltageThreshold 83,
            /// Disable Sink Path if not in PPS contract
            field DisableSinkIfNotInPpsContract 84,
            /// Operation current in Sink PPS mode
            field PpsSinkVoltageThreshold 95:85,
            /// Operation current in Sink PPS mode (50 mA per LSB)
            field PpsOperatingCurrent 102:96,
            /// Desired output voltage (20 mV per LSB)
            field PpsOutputVoltage 115:105,
            /// Enable Sink EPR AVS mode
            field EprAvsEnableSinkMode 128,
            /// AVS operating current
            field EprAvsOperatingCurrent 166:160,
            /// AVS operating voltage
            field EprAvsOutputVoltage 180:169,
        },
    },
    /// PD status
    register PdStatus {
        address: 0x40,
        reset: 0x0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 4,
        
